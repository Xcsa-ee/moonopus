///|
fn play_gate_long() -> Unit raise {
  let pcm = match decode_opus_pcm(GATE_LONG_OPUS) {
    Ok(a) => a
    Err(e) => @test.fail("解码失败：\{e}")
  }
  expect_pcm_close(pcm, gate_long_ref(), "gate/long")
}

///|
test "PCM 差分：libopus 参考 · 20ms VBR 128k 长流（累计漂移）" {
  play_gate_long()
}
