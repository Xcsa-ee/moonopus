///|
fn play_gate_lm0() -> Unit raise {
  let pcm = match decode_opus_pcm(GATE_LM0_OPUS) {
    Ok(a) => a
    Err(e) => @test.fail("解码失败：\{e}")
  }
  expect_pcm_close(pcm, gate_lm0_ref(), "gate/lm0")
}

///|
test "PCM 差分：libopus 参考 · 2.5ms CBR 64k（lm0，密包）" {
  play_gate_lm0()
}

