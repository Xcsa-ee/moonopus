///|
fn play_gate_lm2() -> Unit raise {
  let pcm = match decode_opus_pcm(GATE_LM2_OPUS) {
    Ok(a) => a
    Err(e) => @test.fail("解码失败：\{e}")
  }
  expect_pcm_close(pcm, gate_lm2_ref(), "gate/lm2")
}

///|
test "PCM 差分：libopus 参考 · 10ms VBR 128k（lm2）" {
  play_gate_lm2()
}

