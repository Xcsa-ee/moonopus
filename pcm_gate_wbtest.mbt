///|
fn play_gate_lm1() -> Unit raise {
  let pcm = match decode_opus_pcm(GATE_LM1_OPUS) {
    Ok(a) => a
    Err(e) => @test.fail("解码失败：\{e}")
  }
  expect_pcm_close(pcm, gate_lm1_ref(), "gate/lm1")
}

///|
test "PCM 差分：libopus 参考 · 5ms VBR 96k（lm1）" {
  play_gate_lm1()
}

