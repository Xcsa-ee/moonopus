///|
fn play_gate_lm3() -> Unit raise {
  let pcm = match decode_opus_pcm(GATE_LM3_OPUS) {
    Ok(a) => a
    Err(e) => @test.fail("解码失败：\{e}")
  }
  expect_pcm_close(pcm, gate_lm3_ref(), "gate/lm3")
}

///|
test "PCM 差分：libopus 参考 · 20ms VBR 96k（lm3）" {
  play_gate_lm3()
}

