///|
test "金标：anti-collapse · lm=1 depth=0 与混合位图" {
  play_split_ac_ac6()
}

///|
const ANTI_ACFLAG0_BITS : Bytes = b"\xe5\x19\xf2\x82\x5c\x47\xcc\x60\x4a\xac\xb0\xd8\x0f\x69\x06\xe2\x63\x22\x11\x73\xf6\x39\x70\x3e\x90\xe8\xd6\x1b\xad\x5b\x64\xc9\xef\x16\x1d\x90\x36\x99\x01\x3b\x14\x37\x3f\xd4\x71\x6a\x64\x06\x0e\x3f\x4b\x44\x9e\x7c\x2d\x41\x70\x03\xe2\xa3\x19\xa9\x09\x4d"

///|
fn play_acflag0(dec : RangeDecoder) -> Unit raise {
  // 载荷见 ANTI_ACFLAG0_BITS；期望值由
  // tools/gen_anti_collapse_goldens.py 的独立参考端算出。
  let got = celt_decode_anti_collapse_flag(dec, 8)
  if got != 1 {
    @test.fail("acflag0: flag got \{got} != 1")
  }
  expect_dec_state(dec, "acflag0", 2147483648L, 225642174L, 2, 16)
}

///|
test "金标：anti-collapse 标志位 · 标志位=0 的载荷" {
  let dec = RangeDecoder::new(ANTI_ACFLAG0_BITS)
  play_acflag0(dec)
}

