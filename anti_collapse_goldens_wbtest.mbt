  play_acflag2(dec)
}

///|
/// celt_lcg_rand 从 0 起的 10 步序列（首项即 LCG 常量 1013904223）。
let ac_lcg_seq : Array[Int64] = [
  1013904223L, 1196435762L, 3519870697L, 2868466484L, 1649599747L, 2670642822L, 1476291629L,
  2748932008L, 2180890343L, 2498801434L,
]

///|
/// 预留位公式的网格金标：每 4 项一组 [瞬态, lm, 预算, 期望]。
let ac_rsv_grid : Array[Int] = [
  0, 0, 0, 0, 0, 0, 4, 0, 0, 0, 31, 0, 0, 0, 32, 0, 0, 0, 33, 0, 0, 0, 39, 0, 0,
  0, 40, 0, 0, 0, 41, 0, 0, 0, 100, 0, 0, 1, 0, 0, 0, 1, 4, 0, 0, 1, 31, 0, 0, 1,
