  39, 0, 1, 3, 40, 8, 1, 3, 41, 8, 1, 3, 100, 8,
]

///|
test "金标：anti-collapse 预留位公式" {
  for i in 0..<(ac_rsv_grid.length() / 4) {
    let base = i * 4
    let got = celt_anti_collapse_rsv(
      ac_rsv_grid[base] != 0,
      ac_rsv_grid[base + 1],
      ac_rsv_grid[base + 2],
    )
    if got != ac_rsv_grid[base + 3] {
      @test.fail(
        "rsv 网格行 \{i} 期望 \{ac_rsv_grid[base + 3]} 实得 \{got}",
      )
    }
  }
}
