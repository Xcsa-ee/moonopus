///|
test "金标：anti-collapse · 窄窗 start=5 end=12" {
  play_ac6()
}

///|
const ANTI_ACFLAG0_BITS : Bytes = b"\xef\x8b\xf7\xe1\x2f\x12\xd3\x9c\xff\x09\xea\x55\x12\x5f\x51\xb9\x2b\xdc\xc9\xa1\x5d\x0e\x89\x9b\x86\x7f\x3a\x0e\xe3\xf9\xca\x47\x99\xc3\x2c\x32\x85\x44\x60\x0f\xe3\xb9\x9e\xc2\x38\x23\xd3\x08\xa6\xd3\x0a\x73\x54\xc1\x7f\x0c\x6b\xd7\x4f\x04\x0e\x44\xf1\x5e"

///|
fn play_acflag0(dec : RangeDecoder) -> Unit raise {
  // 载荷见 ANTI_ACFLAG0_BITS；期望值由
  // tools/gen_anti_collapse_goldens.py 的参考端算出。
  let got = celt_decode_anti_collapse_flag(dec, 8)
  if got != 0 {
    @test.fail("acflag0: flag \{got} != 0")
  }
  expect_dec_state(dec, "acflag0", 2147483648L, 138019855L, 2, 16)
}

///|
test "金标：anti-collapse 位 · 标志位=0 的载荷" {
  let dec = RangeDecoder::new(ANTI_ACFLAG0_BITS)
  play_acflag0(dec)
}

