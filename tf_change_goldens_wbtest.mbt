///|
test "金标：TF 变换 · 瞬态帧 M=8 无 TF 变化 · 只重排" {
  let x = tfc_in13()
  celt_tf_forward(x, 24, 8, 0)
  expect_tfc_close(x, tfc_f13, "tfc13/fwd", 0.000000001)
  let y = tfc_in13()
  celt_tf_inverse(y, 24, 8, 0)
  expect_tfc_close(y, tfc_i13, "tfc13/inv", 0.000000001)
}

///|
