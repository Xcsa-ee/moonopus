///|
test "金标：TF 变换 · 瞬态帧 M=8 时间对折 · 重排走恒等序" {
  let x = tfc_in10()
  celt_tf_forward(x, 96, 8, -1)
  expect_tfc_close(x, tfc_f10, "tfc10/fwd", 0.000000001)
  let y = tfc_in10()
  celt_tf_inverse(y, 96, 8, -1)
  expect_tfc_close(y, tfc_i10, "tfc10/inv", 0.000000001)
}

