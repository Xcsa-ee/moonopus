///|
test "金标：TF 变换 · 瞬态帧 M=8 重组合 3 级 · 重排被门挡住" {
  let x = tfc_in12()
  celt_tf_forward(x, 96, 8, 3)
  expect_tfc_close(x, tfc_f12, "tfc12/fwd", 0.000000001)
  let y = tfc_in12()
  celt_tf_inverse(y, 96, 8, 3)
  expect_tfc_close(y, tfc_i12, "tfc12/inv", 0.000000001)
}

