///|
test "金标：TF 变换 · 奇数带宽 · 不进时间对折循环" {
  let x = tfc_in14()
  celt_tf_forward(x, 3, 1, -2)
  expect_tfc_close(x, tfc_f14, "tfc14/fwd", 0.000000001)
  let y = tfc_in14()
  celt_tf_inverse(y, 3, 1, -2)
  expect_tfc_close(y, tfc_i14, "tfc14/inv", 0.000000001)
}

