///|
test "金标：TF 变换 · 长块帧 时间对折 1 级 · seqency 重排 stride=2" {
  let x = tfc_in0()
  celt_tf_forward(x, 96, 1, -1)
  expect_tfc_close(x, tfc_f0, "tfc0/fwd", 0.000000001)
  let y = tfc_in0()
  celt_tf_inverse(y, 96, 1, -1)
  expect_tfc_close(y, tfc_i0, "tfc0/inv", 0.000000001)
}

