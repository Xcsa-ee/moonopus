///|
let ro0_x : Array[Double] = [
  -0.7905426283721149, -0.7747046758859724, -0.7588667233998299, -0.7430287709136872,
]

///|
let ro0_out : Array[Double] = [
  -0.736609264702517, -0.7740384060383174, -0.7864809394867918, -0.769944484594981,
]

///|
test "金标：展宽旋转 · 最小带 4 维 · 仅主相位 · spread=1" {
