///|
test "金标：quant_all_bands · 保守 cm 的 tf 判定" {
  let dec = RangeDecoder::new(QAB_QAB11_BITS)
  play_qab11(dec)
}

///|
const QAB_QAB12_BITS : Bytes = b"\xd9\x2a\xce\x06\x33\x48\xe3\x79\x51\x82\x0f\xd8\xc3\x60\xff\x92\x3e\xf8\x59\x5d\x30\xfe\x73\x36\x3b\x6a\x13\x7c\xcb\x8c\x95\xf8"

